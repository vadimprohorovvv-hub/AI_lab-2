   "source": [
    "import numpy as np\n",
    "\n",
    "arr = np.linspace(-10, 10, 50)\n",
    "\n",
    "total_sum = np.sum(arr)\n",
    "positive_sum = np.sum(arr[arr > 0])\n",
    "negative_sum = np.sum(arr[arr < 0])\n",
    "\n",
    "print(total_sum)\n",
    "print(positive_sum)\n",
    "print(negative_sum)"
