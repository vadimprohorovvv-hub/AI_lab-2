   "source": [
    "import numpy as np\n",
    "\n",
    "matrix = np.random.randint(1, 11, (3, 3))\n",
    "\n",
    "print(matrix)\n",
    "\n",
    "det = np.linalg.det(matrix)\n",
    "print(det)\n",
    "\n",
    "if det != 0:\n",
    "    inv_matrix = np.linalg.inv(matrix)\n",
    "    print(inv_matrix)\n",
    "else:\n",
    "    print(\"Матрица вырождена\")"
   ]
